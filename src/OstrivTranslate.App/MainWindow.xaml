<Window x:Class="OstrivTranslate.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Title}" Width="1440" Height="960" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid x:Name="Workspace" Margin="24,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="6"/><RowDefinition Height="240"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource Title}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><TextBlock Text="{DynamicResource UiLanguage}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Muted}"/><ComboBox x:Name="UiLanguageBox" Width="150" SelectedValuePath="Tag" SelectionChanged="UiLanguage_Changed"><ComboBoxItem Tag="be">Беларуская</ComboBoxItem><ComboBoxItem Tag="ru">Русский</ComboBoxItem><ComboBoxItem Tag="en">English</ComboBoxItem></ComboBox></StackPanel>
      </Grid>
      <WrapPanel Grid.Row="1" Margin="0,0,0,10">
        <Button Content="{DynamicResource OpenGame}" Click="OpenGame_Click"/><Button Content="{DynamicResource OpenProject}" Click="OpenProject_Click"/>
        <Button Content="{DynamicResource Save}" Click="Save_Click" IsEnabled="{Binding HasProject}"/><Button Content="{DynamicResource SaveAs}" Click="SaveAs_Click" IsEnabled="{Binding HasProject}"/>
        <Button Content="{DynamicResource Rescan}" Click="Rescan_Click" IsEnabled="{Binding HasProject}"/><Button Content="{DynamicResource ImportCsv}" Click="ImportCsv_Click" IsEnabled="{Binding HasProject}"/><Button Content="{DynamicResource ExportCsv}" Click="ExportCsv_Click" IsEnabled="{Binding HasProject}"/>
      </WrapPanel>
      <Border Grid.Row="2" Background="#EAF0EE" CornerRadius="5" Padding="12,9" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="SourceLabel" Text="{DynamicResource NoProject}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/><TextBlock x:Name="ProfileWarning" Visibility="Collapsed" Foreground="#9C4B14" Text="{DynamicResource UnsupportedBuild}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
      <Grid Grid.Row="3" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource TargetLanguage}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="TargetLanguageBox" SelectionChanged="TargetLanguage_Changed"/></StackPanel>
        <Button Grid.Column="1" Content="{DynamicResource AddLanguage}" Click="AddLanguage_Click" IsEnabled="{Binding HasProject}" VerticalAlignment="Bottom" Margin="8,0,14,0"/>
        <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="{DynamicResource Search}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed"/></StackPanel>
        <ComboBox x:Name="FilterBox" Grid.Column="3" VerticalAlignment="Bottom" SelectedIndex="5" SelectionChanged="Filter_Changed"><ComboBoxItem Content="{DynamicResource All}"/><ComboBoxItem Content="{DynamicResource Untranslated}"/><ComboBoxItem Content="{DynamicResource Errors}"/><ComboBoxItem Content="{DynamicResource Longer}"/><ComboBoxItem Content="{DynamicResource Candidates}"/><ComboBoxItem Content="{DynamicResource ConfirmedOnly}"/></ComboBox>
      </Grid>
      <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="EntriesGrid" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Entry_Changed" RowHeight="39" CanUserSortColumns="True" ToolTip="{DynamicResource SelectionHint}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource Original}" Binding="{Binding OriginalPreview}" Width="*"/>
            <DataGridTextColumn Header="{DynamicResource Translation}" Binding="{Binding TranslationPreview}" Width="*"/>
            <DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status}" Width="190"/>
            <DataGridTextColumn Header="{DynamicResource Length}" Binding="{Binding LengthText}" Width="205"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" x:Name="SummaryLabel" Margin="0,8,0,4" Foreground="{StaticResource Muted}" FontSize="12"/>
      </Grid>
      <GridSplitter Grid.Row="5" HorizontalAlignment="Stretch" Height="6" Background="Transparent"/>
      <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="DetailsHeading"><TextBlock Text="{DynamicResource Details}" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="Bold"/><TextBlock x:Name="ContextLabel" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,10,8" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><CheckBox Grid.Column="1" x:Name="ApproveBox" Content="{DynamicResource Approve}" VerticalAlignment="Top" Click="Approve_Click"/></Grid>
          <Grid Grid.Row="1" x:Name="EntryEditors"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Selected.Entry.Original, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F5F8F7" VerticalContentAlignment="Top"/>
            <TextBox x:Name="TranslationEditor" Grid.Column="2" Text="{Binding Selected.Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" IsEnabled="{Binding CanEdit}" ToolTip="{DynamicResource EmptyHint}"/>
          </Grid>
          <StackPanel Grid.Row="2" x:Name="EntryMetrics" Margin="0,8,0,0"><TextBlock x:Name="BytesLabel" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="IssuesLabel" FontSize="12" Foreground="#9C4B14" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="7" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusLabel" Text="{DynamicResource Ready}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource RenderingNotice}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,14,0"/></StackPanel>
        <ComboBox x:Name="ModeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="Mode_Changed" VerticalAlignment="Center" Margin="0,0,12,0"><ComboBoxItem Content="{DynamicResource Extended}"/><ComboBoxItem Content="{DynamicResource Strict}"/></ComboBox>
        <Button Grid.Column="2" Content="{DynamicResource Build}" Click="Build_Click" IsEnabled="{Binding CanBuild}" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" VerticalAlignment="Center" Padding="20,11"/>
        <Button Grid.Column="3" x:Name="LaunchButton" Content="{DynamicResource Launch}" Click="Launch_Click" VerticalAlignment="Center" IsEnabled="False" Margin="0"/>
      </Grid>
    </Grid>
    <Border x:Name="BusyOverlay" Background="#DBF5F7F6" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320"><TextBlock Text="{DynamicResource Busy}" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,16"/><ProgressBar IsIndeterminate="True" Height="4" Foreground="{StaticResource Accent}"/></StackPanel></Border>
  </Grid>
</Window>
